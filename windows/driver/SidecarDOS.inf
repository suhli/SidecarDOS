[Version]
Signature="$WINDOWS NT$"
Class=Display
ClassGuid={4d36e968-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=09/04/2026,0.1.0.0
CatalogFile=SidecarDOS.cat
PnpLockdown=1

[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000

[Models.NTamd64.10.0...22000]
%Device%=Install,Root\SidecarDOS

[SourceDisksNames]
1=%Disk%

[SourceDisksFiles]
SidecarDOS.dll=1

[DestinationDirs]
DriverCopy=13

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
SidecarDOS.dll

[Install.NT.HW]
AddReg=Hardware

[Hardware]
HKR,,UpperFilters,%REG_MULTI_SZ%,"IndirectKmd"
HKR,"WUDF","DeviceGroupId",0x00000000,"SidecarDOS"
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGW;;;IU)"

[Install.NT.Services]
AddService=IndirectKmd,0x000001fa,IndirectService

[IndirectService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\IndirectKmd.sys

[Install.NT.Wdf]
UmdfService=SidecarDOS,UMDF
UmdfServiceOrder=SidecarDOS
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfExtensions=IddCx0102
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfFsContextUsePolicy=CanUseFsContext2

[UMDF]
UmdfLibraryVersion=2.25.0
ServiceBinary=%13%\SidecarDOS.dll
UmdfHostProcessSharing=ProcessSharingDisabled

[Strings]
